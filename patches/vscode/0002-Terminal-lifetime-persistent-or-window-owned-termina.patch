+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Disposable, MutableDisposable } from '../../base/common/lifecycle.js';
+import { ILogService } from '../../platform/log/common/log.js';
+import { IProcessPropertyMap, IPtyHostService, ProcessPropertyType, TerminalLifetime } from '../../platform/terminal/common/terminal.js';
+import { IServerLifetimeService } from './serverLifetimeService.js';
+
+/**
+ * Keeps the server from auto-shutting down while the pty host has Persistent terminals, so they
+ * outlive every window. The pty host runs inside the server, so the server going idle would
+ * otherwise end them.
+ */
+export class PtyHostKeepAlive extends Disposable {
+	private readonly _persistentIds = new Set<number>();
+	private readonly _lifetimeToken = this._register(new MutableDisposable());
+
+	constructor(
+		ptyHostService: IPtyHostService,
+		private readonly _serverLifetimeService: IServerLifetimeService,
+		private readonly _logService: ILogService,
+	) {
+		super();
+		this._register(ptyHostService.onDidChangeProperty(e => {
+			if (e.property.type !== ProcessPropertyType.Lifetime) {
+				return;
+			}
+			const info = e.property.value as IProcessPropertyMap[ProcessPropertyType.Lifetime];
+			if (info?.lifetime === TerminalLifetime.Persistent) {
+				this._persistentIds.add(e.id);
+			} else {
+				this._persistentIds.delete(e.id);
+			}
+			this._update();
+		}));
+		this._register(ptyHostService.onProcessExit(e => {
+			if (this._persistentIds.delete(e.id)) {
+				this._update();
+			}
+		}));
+		this._register(ptyHostService.onPtyHostExit(() => {
+			this._persistentIds.clear();
+			this._update();
+		}));
+	}
+
+	private _update(): void {
+		if (this._persistentIds.size > 0) {
+			if (!this._lifetimeToken.value) {
+				this._logService.info(`PtyHostKeepAlive: ${this._persistentIds.size} persistent terminal(s), keeping the server alive`);
+				this._lifetimeToken.value = this._serverLifetimeService.active('PtyHost');
+			}
+		} else if (this._lifetimeToken.value) {
+			this._logService.info('PtyHostKeepAlive: no persistent terminals left, the server may shut down when idle');
+			this._lifetimeToken.clear();
+		}
+	}
+}
