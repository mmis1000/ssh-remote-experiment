From: mmis1000 <mmis10002@gmail.com>
Date: Thu, 15 Oct 2026 21:14:24 +0800
Subject: [PATCH 5/6] Terminal shutdown: follow up a SIGHUP the shell ignores

Bash ignores the first SIGHUP while readline waits for the rest of an escape
sequence (e.g. after the user pressed Escape), so killing such a terminal left
its shell running on the host. Send SIGHUP again after 1s and SIGKILL after 5s
if the process is still alive.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../platform/terminal/node/terminalProcess.ts | 42 ++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/vs/platform/terminal/node/terminalProcess.ts b/src/vs/platform/terminal/node/terminalProcess.ts
index d486105f..c053f139 100644
--- a/src/vs/platform/terminal/node/terminalProcess.ts
+++ b/src/vs/platform/terminal/node/terminalProcess.ts
@@ -39,7 +39,17 @@ const enum ShutdownConstants {
 	/**
 	 * The maximum ms to allow after dispose is called because forcefully killing the process.
 	 */
-	MaximumShutdownTime = 5000
+	MaximumShutdownTime = 5000,
+	/**
+	 * How long a process may take to exit after SIGHUP before it gets a second one. Bash ignores
+	 * the first SIGHUP while readline waits for the rest of an escape sequence (e.g. after the
+	 * user pressed Escape) and exits on the second.
+	 */
+	RepeatHangupTime = 1000,
+	/**
+	 * How long a process may take to exit after SIGHUP before it is killed with SIGKILL.
+	 */
+	ForceKillTime = 5000
 }
 
 const enum Constants {
@@ -402,6 +412,9 @@ export class TerminalProcess extends Disposable implements ITerminalChildProcess
 				await this._throttleKillSpawn();
 				this._logService.trace('node-pty.IPty#kill');
 				this._ptyProcess.kill();
+				if (!isWindows) {
+					this._ensureExit(this._ptyProcess.pid);
+				}
 			}
 		} catch (ex) {
 			// Swallow, the pty has already been killed
@@ -410,6 +423,33 @@ export class TerminalProcess extends Disposable implements ITerminalChildProcess
 		this.dispose();
 	}
 
+	/**
+	 * Follows up a SIGHUP that the process may not act on. This runs past the disposal of this
+	 * object, which happens right after the kill.
+	 */
+	private _ensureExit(pid: number): void {
+		const isAlive = () => {
+			try {
+				process.kill(pid, 0);
+				return true;
+			} catch {
+				return false;
+			}
+		};
+		setTimeout(() => {
+			if (isAlive()) {
+				this._logService.info(`Process ${pid} is still running after SIGHUP, sending it again`);
+				try { process.kill(pid, 'SIGHUP'); } catch { /* exited */ }
+			}
+		}, ShutdownConstants.RepeatHangupTime);
+		setTimeout(() => {
+			if (isAlive()) {
+				this._logService.warn(`Process ${pid} is still running after SIGHUP, killing it`);
+				try { process.kill(pid, 'SIGKILL'); } catch { /* exited */ }
+			}
+		}, ShutdownConstants.ForceKillTime);
+	}
+
 	private async _throttleKillSpawn(): Promise<void> {
 		// Only throttle on Windows/conpty
 		if (!isWindows || !hasConptyOption(this._ptyOptions) || !this._ptyOptions.useConpty) {
