+let menuTargetKeys: { persistent: IContextKey<boolean>; windowOwned: IContextKey<boolean> } | undefined;
+
+/** Binds the keys that describe the terminals a context menu acts on; the terminal service calls it once. */
+export function bindTerminalMenuTargetKeys(contextKeyService: IContextKeyService): void {
+	menuTargetKeys = {
+		persistent: TerminalContextKeys.menuTargetsPersistent.bindTo(contextKeyService),
+		windowOwned: TerminalContextKeys.menuTargetsWindowOwned.bindTo(contextKeyService),
+	};
+}
+
+/**
+ * Describes the terminals a context menu is about to act on, so its items can depend on them
+ * (e.g. Make Persistent only for a terminal that isn't). Call it before getting the menu's actions.
+ */
+export function setTerminalMenuTargets(instances: SingleOrMany<ITerminalInstance> | undefined): void {
+	const targets = instances ? asArray(instances) : [];
+	menuTargetKeys?.persistent.set(targets.some(i => i.lifetime?.lifetime === TerminalLifetime.Persistent));
+	menuTargetKeys?.windowOwned.set(targets.some(i => i.lifetime?.lifetime === TerminalLifetime.WindowOwned));
+}
+
 export function openContextMenu(targetWindow: Window, event: MouseEvent, contextInstances: SingleOrMany<ITerminalInstance> | undefined, menu: IMenu, contextMenuService: IContextMenuService, extraActions?: IAction[]): void {
