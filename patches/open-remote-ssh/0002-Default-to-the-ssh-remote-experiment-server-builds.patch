diff --git a/src/server-config/experiment.ts b/src/server-config/experiment.ts
new file mode 100644
index 0000000..4134ef6
--- /dev/null
+++ b/src/server-config/experiment.ts
@@ -0,0 +1,20 @@
+// Remote servers built by https://github.com/mmis1000/ssh-remote-experiment, which carries the
+// terminal changes this build of the extension is meant for.
+const EXPERIMENT_BASE_URL = 'https://mmis1000.me/ssh-remote-experiment';
+
+/** Download URL of a server build, by the commit that built it (which is also its product commit). */
+export const EXPERIMENT_DOWNLOAD_URL_TEMPLATE = `${EXPERIMENT_BASE_URL}/reh/\${commit}/vscodium-reh-\${os}-\${arch}.tar.gz`;
+
+/** The commit of the latest published server build, or undefined if it can't be fetched. */
+export async function fetchLatestExperimentCommit(): Promise<string | undefined> {
+    try {
+        const response = await fetch(`${EXPERIMENT_BASE_URL}/builds.json`);
+        if (!response.ok) {
+            return undefined;
+        }
+        const builds = await response.json() as { latest?: unknown };
+        return typeof builds.latest === 'string' && /^[0-9a-f]{40}$/.test(builds.latest) ? builds.latest : undefined;
+    } catch {
+        return undefined;
+    }
+}
